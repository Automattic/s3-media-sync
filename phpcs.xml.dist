<?xml version="1.0"?>
<ruleset name="S3 Media Sync">
	<description>PHP_CodeSniffer configuration for S3 Media Sync</description>

	<!-- Check all PHP files in the plugin -->
	<file>.</file>

	<!-- Exclude vendor directory -->
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>tests/bootstrap.php</exclude-pattern>

	<!-- Use WordPress coding standards -->
	<rule ref="WordPress">
		<!-- Exclude rules that are too strict for this project -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
	</rule>

	<!-- Use WordPress-Extra rules -->
	<rule ref="WordPress-Extra">
		<!-- Allow short open tags for WordPress -->
		<exclude name="Generic.PHP.DisallowShortOpenTag.EchoFound"/>
	</rule>

	<!-- Use WordPress-Docs rules for documentation -->
	<rule ref="WordPress-Docs"/>

	<!-- Minimum supported WordPress version -->
	<config name="minimum_supported_wp_version" value="5.9"/>

	<!-- Check for PHP version compatibility -->
	<config name="testVersion" value="8.1-"/>

	<!-- Allow . in hook names -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="."/>
		</properties>
	</rule>

	<!-- Set text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="s3-media-sync"/>
			</property>
		</properties>
	</rule>
</ruleset>