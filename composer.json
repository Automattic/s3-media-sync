{
	"name": "wpcomvip/s3-media-sync",
	"description": "Sync full media backups to S3.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Alexis Kulash",
			"email": "alexis@wordpress.com",
			"role": "Developer"
		}
	],
	"homepage": "https://github.com/Automattic/s3-media-sync",
	"support": {
		"issues": "https://github.com/Automattic/s3-media-sync/issues",
		"source": "https://github.com/Automattic/s3-media-sync"
	},
	"require": {
		"php": ">=8.1",
		"aws/aws-sdk-php": "~3.366.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"automattic/behat-wp-env-context": "dev-main",
		"automattic/vipwpcs": "^3.0",
		"mockery/mockery": "^1.6",
		"php-parallel-lint/php-parallel-lint": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"yoast/wp-test-utils": "^1.2"
	},
	"autoload": {
		"classmap": [
			"inc/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"S3_Media_Sync\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"@php ./vendor/bin/phpunit --testsuite integration --coverage-text --coverage-html build/coverage"
		],
		"coverage-ci": "@php ./vendor/bin/phpunit",
		"cs": "@php ./vendor/bin/phpcs -q",
		"cs-fix": "@php ./vendor/bin/phpcbf -q",
		"i18n": "@php wp i18n make-pot . ./languages/s3-media-sync.pot",
		"lint": "@php ./vendor/php-parallel-lint/php-parallel-lint/parallel-lint . -e php --exclude vendor --exclude .git",
		"lint-ci": "@php ./vendor/php-parallel-lint/php-parallel-lint/parallel-lint . -e php --exclude vendor --exclude .git --checkstyle",
		"test": "@test:integration",
		"test:unit": "@php ./vendor/bin/phpunit --testsuite Unit",
		"test:cli": "./vendor/bin/behat",
		"test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/s3-media-sync ./vendor/bin/phpunit --testsuite integration",
		"test:integration-ms": "wp-env run tests-cli --env-cwd=wp-content/plugins/s3-media-sync /bin/bash -c 'WP_MULTISITE=1 ./vendor/bin/phpunit --testsuite integration'"
	},
	"scripts-descriptions": {
		"coverage": "Run tests with code coverage reporting",
		"coverage-ci": "Run tests with code coverage reporting and send results to stdout",
		"cs": "Run PHP Code Sniffer",
		"cs-fix": "Run PHP Code Sniffer and fix violations",
		"i18n": "Generate a POT file for translation",
		"lint": "Run PHP linting",
		"lint-ci": "Run PHP linting and send results to stdout",
		"test": "Run all tests",
		"test:unit": "Run unit tests (no WordPress required)",
		"test:cli": "Run Behat CLI tests",
		"test:integration": "Run integration tests",
		"test:integration-ms": "Run integration tests in multisite mode"
	}
}
