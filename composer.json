{
	"name": "wpcomvip/s3-media-sync",
	"description": "Sync full media backups to S3.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Alexis Kulash",
			"email": "alexis@wordpress.com",
			"role": "Developer"
		}
	],
	"homepage": "https://github.com/Automattic/s3-media-sync",
	"support": {
		"issues": "https://github.com/Automattic/s3-media-sync/issues",
		"source": "https://github.com/Automattic/s3-media-sync"
	},
	"require": {
		"php": "^8.1",
		"aws/aws-sdk-php": "~3.393.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.0",
		"mockery/mockery": "^1.6",
		"php-parallel-lint/php-parallel-lint": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"yoast/wp-test-utils": "^1.2"
	},
	"autoload": {
		"classmap": [
			"inc/"
		],
		"exclude-from-classmap": [
			"inc/class-s3-media-sync-wp-cli.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"S3_Media_Sync\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"./vendor/bin/phpunit --testsuite integration --coverage-text --coverage-html build/coverage"
		],
		"cs": "@php ./vendor/bin/phpcs",
		"cs-fix": "@php ./vendor/bin/phpcbf",
		"i18n": [
			"@php wp i18n make-pot . ./languages/s3-media-sync.pot"
		],
		"lint": "parallel-lint . --exclude vendor --exclude node_modules --exclude .git",
		"test": [
			"@test:integration"
		],
		"test:integration": "npx wp-env run tests-cli --env-cwd=wp-content/plugins/s3-media-sync ./vendor/bin/phpunit --testsuite integration",
		"test:integration-ms": "npx wp-env run tests-cli --env-cwd=wp-content/plugins/s3-media-sync /bin/bash -c 'WP_MULTISITE=1 ./vendor/bin/phpunit --testsuite integration'"
	},
	"scripts-descriptions": {
		"coverage": "Run tests with code coverage reporting",
		"cs": "Run PHP CodeSniffer to check code style",
		"cs-fix": "Run PHP Code Beautifier to auto-fix code style issues",
		"i18n": "Generate a POT file for translation",
		"lint": "Run PHP parallel lint to check for syntax errors",
		"test": "Run all tests for the S3 Media Sync plugin.",
		"test:integration": "Run integration tests via wp-env.",
		"test:integration-ms": "Run integration tests in multisite mode via wp-env."
	}
}
