{
	"name": "wpcomvip/s3-media-sync",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"support": {
		"issues": "https://github.com/Automattic/s3-media-sync/issues",
		"source": "https://github.com/Automattic/s3-media-sync"
	},
	"require": {
		"php": "^8.1",
		"aws/aws-sdk-php": "~3.288.1",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"mockery/mockery": "^1.6",
		"phpunit/phpunit": "^9.6",
		"yoast/wp-test-utils": "^1.2",
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^1.10",
		"szepeviktor/phpstan-wordpress": "^1.3"
	},
	"autoload": {
		"classmap": [
			"inc/"
		],
		"exclude-from-classmap": [
			"inc/class-s3-media-sync-wp-cli.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"S3_Media_Sync\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"./vendor/bin/phpunit --testsuite integration --coverage-text --coverage-html build/coverage"
		],
		"coverage-ci": [
			"@putenv XDEBUG_MODE=coverage",
			"./vendor/bin/phpunit --testsuite integration --coverage-clover build/logs/clover.xml"
		],
		"prepare-ci": [
			"bash bin/install-wp-tests.sh wordpress_test root root localhost"
		],
		"test": [
			"@test-unit",
			"@test-integration"
		],
		"test-unit": "./vendor/bin/phpunit --configuration phpunit-unit.xml.dist",
		"test-integration": "./vendor/bin/phpunit --testsuite integration",
		"test-ms": [
			"@putenv WP_MULTISITE=1",
			"@composer test"
		],
		"phpcs": "./vendor/bin/phpcs",
		"phpcbf": "./vendor/bin/phpcbf",
		"phpstan": "./vendor/bin/phpstan analyse",
		"lint": [
			"@phpcs",
			"@phpstan"
		],
		"lint-fix": [
			"@phpcbf"
		]
	},
	"scripts-descriptions": {
		"coverage": "Run tests with code coverage reporting",
		"coverage-ci": "Run tests with code coverage for CI (clover format)",
		"test": "Run all tests for the S3 Media Sync plugin.",
		"test-unit": "Run unit tests only",
		"test-integration": "Run integration tests with code coverage for the S3 Media Sync plugin, and send results to stdout.",
		"phpcs": "Run PHP CodeSniffer to check coding standards",
		"phpcbf": "Run PHP Code Beautifier and Fixer to automatically fix coding standards issues",
		"phpstan": "Run PHPStan static analysis",
		"lint": "Run all linting tools (phpcs and phpstan)",
		"lint-fix": "Automatically fix coding standards issues"
	}
}
